# Product "core", major 3: DIGIT core 3.x (helm.digit.org/digit3/core).
# Deployed by a master helmfile (helmfile/digit3-saas), never edited per environment.
#
# .Values (from the master helmfile):
#   product.version    the release to deploy, 3.x.y = releases/<version>.yaml (chart versions)
#   product.enabled    false = uninstall every release of the product
#   global             environment-wide values (domain, ...)
#   <chart>            values for that chart; <chart>.enabled: false leaves it out
# Keycloak first, then Kong, then idgen, then every other service of the release.
{{- $v := .Values }}
{{- $p := $v.product }}
{{- $ver := $p.version | toString }}
{{- if not (regexMatch "^3\\.[0-9]+\\.[0-9]+$" $ver) }}{{ fail (printf "core v3: version %q is not 3.x.y" $ver) }}{{ end }}
{{- $charts := (readFile (printf "releases/%s.yaml" $ver) | fromYaml).charts }}
{{- $ns := "egov" }}
{{- $global := merge (dict "namespace" $ns) ($v | get "global" dict) }}
repositories:
  - name: digit3-core
    url: https://helm.digit.org/digit3/core

helmDefaults:
  createNamespace: true
  wait: true
  waitForJobs: true
  timeout: 900

releases:
{{- range $c := keys $charts | sortAlpha }}
{{- $wave := "6" }}{{ $needs := list "egov/kong" }}
{{- if eq $c "keycloak" }}{{ $wave = "4" }}{{ $needs = list }}
{{- else if eq $c "kong" }}{{ $wave = "5" }}{{ $needs = list "egov/keycloak" }}
{{- else if eq $c "idgen" }}{{ $wave = "5" }}
{{- /* registry's migrations create the idgen tables in their final shape; idgen's own migrations
       create them and then rename columns, which fails if registry ran first. */}}
{{- else if and (eq $c "registry") (hasKey $charts "idgen") }}{{ $needs = append $needs "egov/idgen" }}
{{- end }}
  - name: {{ $c }}
    namespace: {{ $ns }}
    chart: digit3-core/{{ $c }}
    version: {{ index $charts $c | quote }}
    installed: {{ and ($p | get "enabled" true) ($v | get (printf "%s.enabled" $c) true) }}
    labels: {product: core, wave: "{{ $wave }}"}
    needs: {{ $needs | toJson }}
    values:
{{- if ne $c "kong" }}
      - {global: {{ $global | toJson }}, namespace: {{ $ns }}}
{{- end }}
      - {{ omit ($v | get $c dict) "enabled" | toJson }}
{{- end }}
